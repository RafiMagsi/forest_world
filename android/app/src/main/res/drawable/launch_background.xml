<?xml version="1.0" encoding="utf-8"?>
<!-- ForestOS splash: deep forest with the leaf mark, matching the app's first
     frame so launch never flashes white. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/forest_deep" />
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
